# Copy this file to `.streamlit/secrets.toml` and fill in your values.
# `.streamlit/secrets.toml` is gitignored — do NOT commit credentials.
#
# In Streamlit Community Cloud, paste these same values into
# the app's "Advanced settings → Secrets" panel.

# Email that will get edit access to the auto-created workbook.
editor_email = "your.email@gmail.com"

# Optional. Defaults to "תזרים ועוד - DB". Pick any name you like — the app
# will look for an existing workbook with this name (in the service account's
# Drive) and create one if missing.
# spreadsheet_name = "תזרים ועוד - DB"

# Optional. If you already created a workbook and want to pin to its ID
# (the long string in the sheet URL), set it here. Overrides spreadsheet_name.
# spreadsheet_id = "1AbCdEfGhIjKlMnOpQrStUvWxYz1234567890"

# Paste the contents of the service-account JSON file here.
# Note: TOML requires the private_key to keep its literal newlines (\n) inside the string.
[gcp_service_account]
type = "service_account"
project_id = "your-gcp-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "your-sa@your-gcp-project-id.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/your-sa%40your-gcp-project-id.iam.gserviceaccount.com"
universe_domain = "googleapis.com"
